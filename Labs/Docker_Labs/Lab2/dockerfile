# Stage 1: Build and Train the Model
FROM python:3.10-slim AS model_training

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY src/model_training.py /app/
RUN python model_training.py


# Stage 2: Serve Predictions
FROM python:3.10-slim AS serving

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY --from=model_training /app/wine_model.joblib /app/
COPY src/main.py /app/
COPY src/templates /app/templates

EXPOSE 4000
# Flask listens on port 4000 inside the container; publish it with -p <host_port>:4000

CMD ["python", "main.py"]
